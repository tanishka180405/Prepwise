# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl

# ── Virtual environments ─────────────────────────────
venv/
.venv/
env/

# ── Environment variables (any directory) ────────────
**/.env
**/.env.*
!**/.env.example

# ── Secrets & credentials ────────────────────────────
*.pem
*.key
*.crt
*.p12

# ── Database ─────────────────────────────────────────
*.db
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ── IDE & Editors ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*

# ── Node (in case frontend evolves) ──────────────────
node_modules/
package-lock.json

# ── Docker volumes ───────────────────────────────────
postgres_data/
redis_data/

# ── Misc ─────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
